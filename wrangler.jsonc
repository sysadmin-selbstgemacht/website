// Cloudflare Workers mit statischen Assets.
// Nur die gebaute Seite (dist/) wird ausgeliefert, kein eigener Server-Code.
// Formular-Funktion (ALTCHA) kommt später als "main"-Skript dazu.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "selbst-gemacht",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  // Vorschau je Branch und Pull Request (Workers Builds, Befehl `npx wrangler preview`).
  // Leer lassen: Assets und Einstellungen oben gelten auch für die Vorschau.
  "previews": {}
}
