// Cloudflare Worker mit statischen Assets.
// Die gebaute Seite (dist/) wird direkt ausgeliefert. Nur /api/* läuft durch worker/index.ts.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "selbst-gemacht",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Rate Limit für das Anfrageformular: höchstens 3 Anfragen je 60 s und IP, je Cloudflare-Standort, ungefähr.
  "ratelimits": [
    { "name": "ANFRAGE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  // Versand: Trockenlauf, bis das Postfach feststeht. "senden" schaltet ein.
  // Empfänger (MAIL_AN) und Zugangsdaten stehen NICHT hier, sondern als Variable/Secret bei Cloudflare.
  // Variablen aus dem Dashboard (MAIL_AN, MAIL_VON) bei jedem Deploy behalten; MAIL_MODUS steuert das Repo
  "keep_vars": true,
  "vars": { "MAIL_MODUS": "trockenlauf" },
  "preview_urls": true,
  // Vorschau je Branch und Pull Request (Workers Builds, Befehl `npx wrangler preview`).
  // Leer lassen: Assets und Einstellungen oben gelten auch für die Vorschau.
  "previews": {}
}
