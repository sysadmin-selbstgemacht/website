---
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import Anfrage from '../components/Anfrage.astro';
import '../styles/basis.css';
import '../styles/geruest.css';
import { SEITEN, type SeitenSchluessel } from '../lib/seiten';

// Feste Seiten übergeben `seite` (Angaben aus src/lib/seiten.ts).
// Termine übergeben Titel und Beschreibung direkt.
// anliegen: Zielgruppenseite mit festem Anliegen. Bestimmt auch Seitenfläche und Kennfarbe (body[data-bereich]).
// geruest: Seite ist noch graues Gerüst (alte Platzhalter-Stile, schmale Spalte). Neue Seiten setzen geruest={false}.
type Gemeinsam = { anliegen?: 'gruppe' | 'firma' | 'kursleitung'; geruest?: boolean };
type Props =
  | ({ seite: SeitenSchluessel } & Gemeinsam)
  | ({ titel: string; beschreibung: string; bild?: string; ohneAnfrage?: boolean } & Gemeinsam);
// ohneAnfrage: Seite hat ein eigenes Anfrageformular (Terminseite). Dann kein „Anfragen“ im Kopf und kein Abschnitt #anfrage.

const p = Astro.props;
const angaben = 'seite' in p ? SEITEN[p.seite] : { titel: p.titel, beschreibung: p.beschreibung, bild: p.bild };
const anliegen = p.anliegen;
const ohneAnfrage = 'ohneAnfrage' in p && !!p.ohneAnfrage;
const geruest = p.geruest ?? true;
const BEREICH = { gruppe: 'gruppen', firma: 'tagungen', kursleitung: 'kursleitende' } as const;
const bereich = anliegen ? BEREICH[anliegen] : undefined;
const beschreibung = angaben.beschreibung;
// Teilen-Bild: eigenes der Seite (Termine: Kursbild), sonst das Haus von außen (Bild 144, wie im Anfrage-Bereich)
const STANDARD_BILD = '/teilen/selbstgemacht-haus.jpg';
const bild = ('bild' in angaben ? (angaben.bild as string | undefined) : undefined) ?? STANDARD_BILD;

// Bis zum Go-live wird keine Seite indexiert.
// Beim Go-live auf false setzen (siehe docs/go-live.md).
const NOINDEX = true;
const seitentitel = angaben.titel;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const bildUrl = new URL(bild, Astro.site).href;
const standardBild = bild === STANDARD_BILD;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={kanonisch.href} />
    <!-- Favicon wie bisher auf selbst-gemacht.eu (Logo am Haus, Website-Icon der alten Seite) -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/roboto-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Vorschau beim Teilen (WhatsApp, Facebook, LinkedIn …) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="SELBSTGEMACHT" />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch.href} />
    <meta property="og:image" content={bildUrl} />
    {standardBild && <meta property="og:image:width" content="1200" />}
    {standardBild && <meta property="og:image:height" content="630" />}
    {standardBild && <meta property="og:image:alt" content="Das Haus SELBSTGEMACHT mit Garten und Terrasse im Sommer" />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body data-bereich={bereich}>
    <Kopf ohneAnfrage={ohneAnfrage} />
    <main class:list={{ geruest }}>
      <slot />
    </main>
    {!ohneAnfrage && <Anfrage anliegen={anliegen} />}
    <Fuss />
  </body>
</html>
