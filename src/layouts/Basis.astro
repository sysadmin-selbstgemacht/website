---
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import '../styles/geruest.css';
import { SEITEN, type SeitenSchluessel } from '../lib/seiten';

// Feste Seiten übergeben `seite` (Angaben aus src/lib/seiten.ts).
// Termine übergeben Titel und Beschreibung direkt.
type Props =
  | { seite: SeitenSchluessel; anliegen?: 'gruppe' | 'firma' | 'kursleitung' | 'sonstiges' }
  | { titel: string; beschreibung: string; bild?: string; anliegen?: 'gruppe' | 'firma' | 'kursleitung' | 'sonstiges' };

const p = Astro.props;
const angaben = 'seite' in p ? SEITEN[p.seite] : { titel: p.titel, beschreibung: p.beschreibung, bild: p.bild };
const anliegen = p.anliegen;
const beschreibung = angaben.beschreibung;
const bild = 'bild' in angaben ? (angaben.bild as string | undefined) : undefined;

// Bis zum Go-live wird keine Seite indexiert.
// Beim Go-live auf false setzen (siehe docs/go-live.md).
const NOINDEX = true;
const seitentitel = angaben.titel;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const bildUrl = bild ? new URL(bild, Astro.site).href : undefined;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={kanonisch.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Vorschau beim Teilen (WhatsApp, Facebook, LinkedIn …) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="SELBSTGEMACHT" />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch.href} />
    {bildUrl && <meta property="og:image" content={bildUrl} />}
    <meta name="twitter:card" content={bildUrl ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
  </head>
  <body>
    <Kopf />
    <main>
      <slot />
    </main>
    <Fuss anliegen={anliegen} />
  </body>
</html>
