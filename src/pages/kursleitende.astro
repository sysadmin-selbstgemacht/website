---
import Basis from '../layouts/Basis.astro';
import Abschnitt from '../components/Abschnitt.astro';
---
<Basis seite="kursleitende" anliegen="kursleitung">
  <div class="held"><div><p class="zweck">Kopfbereich: Bild oder Clip</p><h1>Kurse · Retreats</h1><p>Der Rahmen für eure Ideen und die eurer Teilnehmenden.</p></div></div>

  <Abschnitt titel="Was ihr bekommt" zweck="Das ganze Haus exklusiv, Veröffentlichung eures Kurses auf Wunsch, Technik." offen="Gibt es feste Pakete (z. B. Verpflegung)?" />
  <Abschnitt titel="So läuft es" zweck="Anfrage → Gespräch → Vertrag. Kein Vertrag zum Download." />
  <Abschnitt titel="Abrechnung in Kürze" zweck="Teilnehmende zahlen Übernachtung und Verpflegung beim Haus, die Kursgebühr geht an euch." />
  <Abschnitt titel="Gästestimmen" zweck="Zitate von Kursleitenden mit Freigabe." />
</Basis>
