---
import Basis from '../layouts/Basis.astro';
import Abschnitt from '../components/Abschnitt.astro';
---
<Basis titel="Gruppen und Familien" anliegen="gruppe">
  <div class="held"><div><p class="zweck">Kopfbereich: Bild oder Header-Clip „Familie Hero“</p><h1>Gruppen und Familien</h1></div></div>

  <Abschnitt titel="Das ganze Haus für euch" zweck="Exklusive Nutzung, bis zu 30 Gäste, moderne Ausstattung, individuelle Wünsche." offen="Preisanker „ab … € pro Nacht“ ja oder nein?" />
  <Abschnitt titel="Räume und Zimmer" zweck="10 Zimmer, Quadratmeter statt Grundrisse, Aufenthaltsraum, Selbstversorgerküche, Terrassen, Wiese." offen="Schwebezelte: zählen sie zur Bettenzahl, Saison, Aufpreis?" />
  <Abschnitt titel="Verpflegung" zweck="Frühstück aus der Region, Selbstversorgung oder Absprache." />
  <Abschnitt titel="Was ihr dazubuchen könnt" zweck="Lamas, Waldbaden u. a. nur anteasern: „Sprecht uns an“." />
  <Abschnitt titel="Anlässe" zweck="Private Anlässe der Gruppe (z. B. Silberhochzeit) anteasern; keine Feiern mit Catering." />
  <Abschnitt titel="Verfügbarkeit" zweck="Belegte Zeiträume, immer mit Button „Zeitraum anfragen“." offen="Technischer Weg nach Antwort von 3RPMS." />
  <Abschnitt titel="Gästestimmen" zweck="Nur echte Zitate mit Freigabe; Google-Bewertungen mit Quelle." />
  <Abschnitt titel="Anreise" zweck="Mitte Deutschlands, A9/A4/A72." offen="Abholung vom Bahnhof?" />
</Basis>
