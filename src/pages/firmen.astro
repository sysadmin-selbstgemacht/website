---
import Basis from '../layouts/Basis.astro';
import Abschnitt from '../components/Abschnitt.astro';
---
<Basis titel="Firmen" anliegen="firma">
  <div class="held"><div><p class="zweck">Kopfbereich: Header-Clip „Seminarraum Hero“</p><h1>Tagung · Workshop · Seminar</h1></div></div>

  <Abschnitt titel="Ungestört arbeiten" zweck="Exklusiv im Haus, zeitliche Flexibilität: „Wir gehen mit der Tagung, nicht die Tagung mit uns.“" />
  <Abschnitt titel="Tagungsraum und Technik" zweck="Kapazität, Ausstattung, Beamer und Leinwand; kein V-Frame." offen="Zweiter Raum (Frühstücksraum): eigene Sektion oder Zeile?" />
  <Abschnitt titel="Verpflegung" zweck="Leicht, durchdacht, an die Gruppe angepasst. Steht vor dem Tagesablauf." />
  <Abschnitt titel="Ein Tag bei uns" zweck="Beispielablauf ohne Wald und Lamas." />
  <Abschnitt titel="Rahmenprogramm" zweck="Wald, Lamas, Waldbaden für Unternehmen." />
  <Abschnitt titel="Raumplan und Factsheet" zweck="Download als PDF." offen="Wer erstellt es, wer hält es aktuell?" />
  <Abschnitt titel="Gästestimmen" zweck="Zitate von Firmen mit Freigabe." />
  <Abschnitt titel="Preise" zweck="Tagungspauschale „ab … € pro Person und Tag“?" offen="Preisanker ja oder nein, gibt es eine Kalkulation?" />
</Basis>
