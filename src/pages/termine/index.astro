---
// Terminliste: die nächsten 15 Monate, nach Monat gegliedert (Brief 6d, Briefing 20.11. Abschnitt 2).
// Statische Seite: "heute" ist der Zeitpunkt des Builds. Ein kleines Skript blendet im Browser
// zusätzlich aus, was inzwischen vorbei ist. Siehe docs/termine.md.
import { getCollection, getEntries } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Erlebnisse from '../../components/Erlebnisse.astro';
import { monatsName, istMehrtaegig, namenText } from '../../lib/termine';
import { naechte, euro } from '../../lib/termin-felder';
import { ICON } from '../../lib/icons';
import { SEITEN } from '../../lib/seiten';

// Zeilen der Liste (Wireframe „Termine · Desktop“): Datum · Titel mit Leitung und Dauer · Gebühr
const fmt = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', ...o });
const wt = (d: Date) => fmt({ weekday: 'short' }).format(d).replace('.', '');
const tag = (d: Date) => fmt({ day: '2-digit' }).format(d);
function datumZeile(t: { beginn: Date; ende: Date; uhrzeit_beginn: string; uhrzeit_ende: string }) {
  return istMehrtaegig(t)
    ? { fett: `${tag(t.beginn)}.–${tag(t.ende)}. ${wt(t.beginn)}–${wt(t.ende)}`, zusatz: '' }
    : { fett: `${tag(t.beginn)}. ${wt(t.beginn)}`, zusatz: `${t.uhrzeit_beginn}–${t.uhrzeit_ende}` };
}
function dauer(t: { beginn: Date; ende: Date }) {
  const n = naechte(t.beginn, t.ende);
  return n === 0 ? 'eintägig' : `${n} ${n === 1 ? 'Übernachtung' : 'Übernachtungen'}`;
}
function preis(t: { kursgebuehr?: number; uebernachtung: boolean }) {
  return t.kursgebuehr === undefined ? '' : `${euro(t.kursgebuehr)}${t.uebernachtung ? ' zzgl. Übernachtung' : ''}`;
}

const heute = new Date();
heute.setHours(0, 0, 0, 0);
const grenze = new Date(heute);
grenze.setMonth(grenze.getMonth() + 15);

const termine = (await getCollection('termine'))
  .filter((t) => t.data.ende >= heute && t.data.beginn <= grenze)
  .sort((a, b) => a.data.beginn.valueOf() - b.data.beginn.valueOf());

const namen = new Map<string, string>();
for (const t of termine) namen.set(t.id, namenText((await getEntries(t.data.leitung)).map((l) => l.data.name)));

const nachMonat = new Map<string, typeof termine>();
for (const t of termine) {
  const k = monatsName(t.data.beginn);
  nachMonat.set(k, [...(nachMonat.get(k) ?? []), t]);
}
---
<Basis seite="termine" geruest={false}>
  <section class="w termine-kopf">
    <h1 class="h1">Termine</h1>
    <p class="p">Kurse, Retreats und Veranstaltungen der nächsten 15 Monate.<br />Klicken Sie auf einen Termin, dort finden Sie alle Details und die Anmeldung.</p>
    <div class="filter" role="group" aria-label="Termine filtern" data-filter>
      <button type="button" data-f="alle" aria-pressed="true">Alle</button>
      <button type="button" data-f="e" aria-pressed="false">Eintägig</button>
      <button type="button" data-f="m" aria-pressed="false">Mehrtägig</button>
    </div>
  </section>

  <section class="liste" aria-label="Terminliste">
    <div class="w">
      <p class="keine-termine p" hidden={termine.length > 0}>Zurzeit sind keine Termine veröffentlicht.</p>
      {[...nachMonat].map(([monat, liste]) => (
        <section class="termin-monat">
          <h2 class="t-monat">{monat}</h2>
          {liste.map((t) => {
            const z = datumZeile(t.data);
            return (
              <a class="zeile" href={`/termine/${t.id}/`} data-ende={t.data.ende.toISOString().slice(0, 10)} data-art={istMehrtaegig(t.data) ? 'm' : 'e'}>
                <span class="z-datum"><strong>{z.fett}</strong>{z.zusatz && <> · {z.zusatz}</>}</span>
                <span class="z-titel"><span class="z-name">{t.data.titel}</span><span>{namen.get(t.id)} · {dauer(t.data)}</span></span>
                <span class="z-preis">{preis(t.data)}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            );
          })}
        </section>
      ))}
    </div>
  </section>

  <Erlebnisse
    titel="Erlebnis anfragen"
    einleitung="Diese Erlebnisse vereinbaren wir mit Ihnen zu Ihrem Wunschtermin."
    spalten={4}
    karten={[
      { nr: '181', alt: 'Lamas auf der Wiese', titel: 'Lamawanderung', text: '[ein Satz]' },
      { nr: '357', alt: 'Kräuter und Zutaten auf dem Tisch', titel: 'Kräuterwanderung', text: '[ein Satz]' },
      { nr: '260', alt: 'Pizza wird in den Steinofen geschoben', titel: 'Pizza backen', text: '[ein Satz]' },
      { nr: '197', alt: 'Filzen mit Kind', titel: 'Filzen', text: '[ein Satz]' },
    ]}
  >
    <div class="w"><a class="knopf umrandet erlebnis-knopf" href="#anfrage">Erlebnis anfragen</a></div>
  </Erlebnisse>

  <section class="w kurs-hinweis-rahmen">
    <div class="kurs-hinweis">
      <div class="kh-text">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON.menschen} />
        <div><span class="kh-titel">Ihren eigenen Kurs veranstalten</span><span>Sie gestalten Ihren Kurs, wir sorgen für den Rahmen: das ganze Haus für Ihre Gruppe.</span></div>
      </div>
      <a class="textlink" href={SEITEN.kursleitende.pfad}>Mehr für Kursleitende<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
    </div>
  </section>

  <script>
    // Vergangene Termine ausblenden (Datum nach Ortszeit des Hauses), leere Monate mit; Filter eintägig/mehrtägig.
    const heute = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date()); // JJJJ-MM-TT
    const zeilen = [...document.querySelectorAll<HTMLElement>('.zeile[data-ende]')];
    let filter = 'alle';
    function zeigen() {
      zeilen.forEach((t) => { t.hidden = (t.dataset.ende ?? '') < heute || (filter !== 'alle' && t.dataset.art !== filter); });
      let sichtbar = 0;
      document.querySelectorAll<HTMLElement>('.termin-monat').forEach((m) => {
        const n = m.querySelectorAll('.zeile:not([hidden])').length;
        m.hidden = n === 0;
        sichtbar += n;
      });
      const leer = document.querySelector<HTMLElement>('.keine-termine');
      if (leer) { leer.hidden = sichtbar > 0; leer.textContent = filter === 'alle' ? 'Zurzeit sind keine Termine veröffentlicht.' : 'Für diese Auswahl gibt es zurzeit keine Termine.'; }
    }
    document.querySelectorAll<HTMLButtonElement>('[data-filter] button').forEach((b) => b.addEventListener('click', () => {
      filter = b.dataset.f!;
      document.querySelectorAll('[data-filter] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      zeigen();
    }));
    zeigen();
  </script>
</Basis>

<style>
  .termine-kopf { padding-top: 48px; display: flex; flex-direction: column; gap: 16px; }
  .termine-kopf .p { max-width: 720px; }
  .filter { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .filter button { min-height: 44px; padding: 0 18px; border-radius: var(--radius-md); font: inherit; font-size: 15px; color: #000; cursor: pointer; border: 1px solid var(--neutral-500); background: #fff; }
  .filter button[aria-pressed='true'] { border: 2px solid var(--green-800); background: var(--green-100); padding: 0 17px; }
  .liste { display: flow-root; margin-top: 32px; padding-bottom: 48px; background: #fff; }
  .t-monat { margin: 40px 0 8px; font-size: 22px; line-height: 1.3; font-weight: 300; color: #000; }
  .keine-termine { padding-top: 40px; }
  .zeile { display: grid; grid-template-columns: 1fr 24px; gap: 4px 16px; align-items: center; padding: 20px 0; border-top: 1px solid var(--neutral-200); text-decoration: none; color: var(--neutral-600); }
  .zeile > svg { grid-column: 2; grid-row: 1 / span 3; }
  .zeile:hover .z-name { color: var(--green-800); }
  .z-datum, .z-titel, .z-preis { grid-column: 1; font-size: 15px; line-height: 1.5; }
  .z-datum strong { font-weight: 500; color: #000; }
  .z-titel { display: flex; flex-direction: column; gap: 2px; }
  .z-name { font-size: 20px; line-height: 1.3; font-weight: 400; color: #000; }
  .z-preis:empty { display: none; }
  .erlebnis-knopf { margin-top: 24px; }
  .kurs-hinweis-rahmen { padding-top: 64px; }
  .kurs-hinweis { background: #fff; border-radius: var(--radius-xl); padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .kh-text { display: flex; gap: 16px; align-items: flex-start; font-size: 15px; line-height: 1.5; }
  .kh-text svg { flex: 0 0 28px; width: 28px; height: 28px; margin-top: 2px; }
  .kh-text > div { display: flex; flex-direction: column; gap: 4px; }
  .kh-titel { font-size: 18px; font-weight: 500; color: #000; }
  @media (min-width: 1024px) {
    .termine-kopf { padding-top: 96px; }
    .liste { margin-top: 48px; padding-bottom: 64px; }
    .t-monat { margin: 48px 0 8px; font-size: 28px; }
    .zeile { grid-template-columns: 240px 1fr 260px 24px; gap: 24px; padding: 24px 0; }
    .zeile > svg { grid-column: 4; grid-row: 1; }
    .z-datum, .z-titel, .z-preis { grid-column: auto; font-size: 16px; }
    .z-name { font-size: 24px; }
    .z-preis:empty { display: block; }
    .erlebnis-knopf { margin-top: 32px; }
    .kurs-hinweis-rahmen { padding-top: 96px; }
    .kurs-hinweis { padding: 40px 48px; flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; }
    .kh-text { gap: 20px; font-size: 16px; line-height: 1.55; }
    .kh-text svg { flex-basis: 32px; width: 32px; height: 32px; }
    .kh-titel { font-size: 20px; }
  }
</style>
