---
// Detailseite je Termin: teilbarer Link und Veranstaltungsdaten für Suchmaschinen (Brief 6d).
// Aufbau und Inhalte nach Wireframe „Terminseite“ (Canvas) und Briefing 20.11., Abschnitt 3.
// Gestaltung (Farben, Schrift, Kacheln mit Icons) folgt mit dem Design; hier Reihenfolge und Inhalt.
import { getCollection, getEntries, render } from 'astro:content';
import Medienbild from '../../components/Medienbild.astro';
import Anfrageformular from '../../components/Anfrageformular.astro';
import Basis from '../../layouts/Basis.astro';
import { bildUrl } from '../../lib/medien';
import { datumText, datumKurz, datumKopf, datumLang, uhrzeitText, dauerText, namenText } from '../../lib/termine';
import { VERPFLEGUNG, verpflegungZusatz, PREIS_AB_UST, euro, ustText, naechte } from '../../lib/termin-felder';

export async function getStaticPaths() {
  const termine = await getCollection('termine');
  return termine.map((t) => ({ params: { id: t.id }, props: { termin: t, alle: termine } }));
}

const { termin, alle } = Astro.props;
const d = termin.data;
const { Content } = await render(termin);
const leitungen = await getEntries(d.leitung);
const namen = leitungen.map((l) => l.data.name);
const leitungsText = namenText(namen);
const n = naechte(d.beginn, d.ende);

// Externe Termine brauchen einen Weg zur Anmeldung: Mail einer Kursleitung oder Website.
const mail = leitungen.find((l) => l.data.mail)?.data.mail;
if (!d.eigener_termin && !mail && !d.anmeldung_web) {
  throw new Error(`Termin ${termin.id}: externer Termin ohne Mail der Kursleitung und ohne anmeldung_web`);
}

const beschreibung = d.kurzbeschreibung;
const teilenBild = await bildUrl(d.bild, 1200);

const mailLink = mail
  ? `mailto:${mail}?subject=${encodeURIComponent('Anfrage: ' + d.titel)}&body=${encodeURIComponent('Hallo,\n\nich interessiere mich für „' + d.titel + '“ (' + datumText(d.beginn, d.ende) + ').\n\n')}`
  : undefined;

// Weitere Termine mit genau derselben Kursleitung (Briefing 20.11.), kommende zuerst
const schluessel = (ids: { id: string }[]) => ids.map((l) => l.id).sort().join('|');
const heute = new Date();
heute.setHours(0, 0, 0, 0);
const weitere = alle
  .filter((t) => t.id !== termin.id && schluessel(t.data.leitung) === schluessel(d.leitung) && t.data.ende >= heute)
  .sort((a, b) => a.data.beginn.valueOf() - b.data.beginn.valueOf())
  .slice(0, 6);

const uebernachtungen = n === 0 ? '' : `${n} ${n === 1 ? 'Übernachtung' : 'Übernachtungen'} · `;

// schema.org/Event für Suchmaschinen
const eventDaten = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.titel,
  description: beschreibung,
  startDate: `${d.beginn.toISOString().slice(0, 10)}T${d.uhrzeit_beginn}`,
  endDate: `${d.ende.toISOString().slice(0, 10)}T${d.uhrzeit_ende}`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'SELBSTGEMACHT – Seminar- und Gästehaus',
    address: { '@type': 'PostalAddress', streetAddress: 'Arnsgrün 56', postalCode: '07937', addressLocality: 'Zeulenroda-Triebes', addressCountry: 'DE' },
  },
  organizer: namen.map((name) => ({ '@type': 'Person', name })),
  image: new URL(teilenBild, Astro.site).href,
};
---
<Basis titel={`${d.titel} · SELBSTGEMACHT`} beschreibung={beschreibung} bild={teilenBild} ohneAnfrage>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventDaten)} />
  <p><a href="/termine/">← Alle Termine</a></p>
  <p class="offen vorbei" hidden data-ende={d.ende.toISOString().slice(0, 10)}>Dieser Termin ist bereits vorbei. <a href="/termine/">Zu den aktuellen Terminen</a></p>
  <script>
    const v = document.querySelector<HTMLElement>('.vorbei');
    const heute = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date());
    if (v && (v.dataset.ende ?? '') < heute) v.hidden = false;
  </script>

  <Medienbild wert={d.bild} alt={d.bild_alt} nachweis={d.bild_nachweis} sizes="(min-width: 72rem) 70rem, 100vw" priorisiert />

  <section class="termin-kopf">
    <p><strong>{datumKopf(d.beginn, d.ende)}</strong></p>
    <h1>{d.titel}</h1>
    <p>{d.kurzbeschreibung}</p>
  </section>

  <section class="termin-kacheln">
    <div class="kachel">
      <h2>Termin</h2>
      <p>{datumLang(d.beginn, d.ende)}<br />{uebernachtungen}{uhrzeitText(d)}</p>
    </div>
    {d.kursgebuehr !== undefined && d.ust !== undefined && (
      <div class="kachel">
        <h2>Kursgebühr</h2>
        <p>{euro(d.kursgebuehr)} ({ustText(d.ust)}){!d.eigener_termin && <>, zu zahlen an die Kursleitung</>}</p>
      </div>
    )}
    {d.preis_ab !== undefined && (
      <div class="kachel">
        <h2>{d.uebernachtung ? 'Übernachtung und Verpflegung' : 'Verpflegung'}</h2>
        <p>ab {euro(d.preis_ab)} ({PREIS_AB_UST}) pro Person für den gesamten Aufenthalt{d.uebernachtung && ', je nach Zimmerkategorie'}. Gezahlt wird vor Ort.</p>
      </div>
    )}
    {d.verpflegung !== 'keine' && (
      <div class="kachel">
        <h2>Verpflegung</h2>
        <p>{VERPFLEGUNG[d.verpflegung]}. {verpflegungZusatz(d.verpflegung)}</p>
      </div>
    )}
    {leitungen.map((l) => (
      <div class="kachel leitung">
        <Medienbild wert={l.data.foto} alt={l.data.foto_alt} nachweis={l.data.foto_nachweis} sizes="(min-width: 40rem) 30rem, 100vw" />
        <h2>Kursleitung: {l.data.name}</h2>
        {l.data.vorstellung && <p>{l.data.vorstellung}</p>}
      </div>
    ))}
  </section>
  {d.anmeldung_web && <p><a href={d.anmeldung_web} target="_blank" rel="noopener">Website zum Kurs ↗</a></p>}

  <p class="zeile-knoepfe">
    <a class="knopf" href="#anmeldung">Unverbindlich anfragen</a>
    <button type="button" class="teilen" data-titel={d.titel} aria-label="Termin teilen">Teilen</button>
  </p>
  <script>
    document.querySelector<HTMLButtonElement>('.teilen')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      const daten = { title: b.dataset.titel, url: location.href };
      try {
        if (navigator.share) await navigator.share(daten);
        else { await navigator.clipboard.writeText(location.href); b.textContent = 'Link kopiert'; }
      } catch { /* abgebrochen */ }
    });
  </script>

  <section class="abschnitt">
    <h2>Über den Kurs</h2>
    <Content />
  </section>

  {d.uebernachtung && (
    <section class="abschnitt">
      <h2>Zimmer</h2>
      <p>Alle wohnen unter einem Dach, in 10 Zimmern mit eigenem Bad.</p>
      <p class="offen">Zimmerbilder (Slider nach Wireframe), nur bei Terminen mit Übernachtung</p>
    </section>
  )}

  <section id="anmeldung" class="abschnitt anfrage">
    <h2>Interesse?</h2>
    {d.eigener_termin ? (
      <>
        <p>Schreiben Sie uns, wir melden uns innerhalb eines Werktags bei Ihnen.</p>
        <Anfrageformular termin={`${d.titel} · ${datumText(d.beginn, d.ende)}`} />
      </>
    ) : (
      <>
        <p>{leitungsText} {leitungen.length > 1 ? 'beantworten' : 'beantwortet'} Ihre Fragen zum Kurs und {leitungen.length > 1 ? 'nehmen' : 'nimmt'} Ihre Anmeldung entgegen.</p>
        {mailLink && <p><a class="knopf" href={mailLink}>Unverbindlich anfragen</a></p>}
        {!mailLink && d.anmeldung_web && <p><a class="knopf" href={d.anmeldung_web} target="_blank" rel="noopener">Zur Anmeldung ↗</a></p>}
      </>
    )}
  </section>

  {weitere.length > 0 && (
    <section class="abschnitt">
      <h2>Weitere Termine mit {leitungsText}</h2>
      <ul>
        {weitere.map((t) => (
          <li data-ende={t.data.ende.toISOString().slice(0, 10)}><strong>{datumKurz(t.data.beginn)}</strong> <a href={`/termine/${t.id}/`}>{t.data.titel}</a> · {dauerText(t.data)}</li>
        ))}
      </ul>
    </section>
  )}
</Basis>
