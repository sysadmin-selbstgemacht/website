---
// Abschnitt vor einem Bild als Hintergrund, Inhalt links auf hellem Verlauf
// (Startseite „Ein Ort für Entwicklung“, Tagungen „Gut zu wissen“).
// Hochformat-Bilder (3, 24) werden breit beschnitten: Ausschnitt über `position` (object-position) wählen.
// Mobil zeigt der Wireframe das Bild nicht; der Inhalt steht dann auf der Seitenfläche.
import Bild from './Bild.astro';
import { katalogBild, type KatalogNr } from '../lib/bilder';
interface Props { nr: KatalogNr; position?: string; titel: string; id: string }
const { nr, position = 'center', titel, id } = Astro.props;
---
<section class="bild-hg" aria-labelledby={id}>
  <div class="hg" style={`--pos:${position}`}><Bild src={katalogBild(nr)} alt="" sizes="(min-width: 1024px) 100vw, 0px" /></div>
  <div class="w inhalt">
    <div class="spalte">
      <h2 class="h2" id={id}>{titel}</h2>
      <slot />
    </div>
  </div>
</section>

<style>
  .bild-hg { position: relative; margin-top: 64px; }
  .hg { display: none; }
  .spalte { display: flex; flex-direction: column; gap: 16px; }
  @media (min-width: 1024px) {
    .bild-hg { margin-top: 120px; min-height: 706px; padding: 96px 0; display: flex; align-items: center; }
    .hg { display: block; position: absolute; inset: 0; }
    .hg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
    .hg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to right, color-mix(in srgb, var(--seite, var(--neutral-50)) 95%, transparent) 0%, color-mix(in srgb, var(--seite, var(--neutral-50)) 85%, transparent) 38%, transparent 56%); }
    .inhalt { position: relative; }
    .spalte { width: 560px; }
    .spalte > :global(.h2) { margin-bottom: 24px; }
  }
</style>
