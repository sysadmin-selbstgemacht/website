---
// Abschnitt „Anfrage“ (#anfrage) vor dem Footer, Varianten nach „Konzept C“ (Handoff 21.11.):
//   - ohne anliegen: „Haus anfragen“ mit Anliegen-Chips (Startseite, Termine, Über uns)
//   - mit anliegen:  festes Anliegen; Desktop mit Hausbild links (Katalog 144), Formular rechts; mobil ohne Bild
import type { ImageMetadata } from 'astro';
import Anfrageformular from './Anfrageformular.astro';
import Bild from './Bild.astro';
import { katalogBild } from '../lib/bilder';
import type { Anliegen } from '../lib/anfrage';

interface Props {
  anliegen?: Exclude<Anliegen, 'termin' | 'sonstiges'>;
  bild?: ImageMetadata; // Standard: Hausbild 144 (Bildliste)
  bildAlt?: string;
}
const { anliegen, bild, bildAlt = 'Das Haus mit Rasen und Terrasse im Sommer' } = Astro.props;
const TITEL: Record<string, string> = {
  gruppe: 'Haus für Ihre Gruppe anfragen',
  firma: 'Haus für Ihre Tagung anfragen',
  kursleitung: 'Haus für Ihren Kurs anfragen',
};
const titel = anliegen ? TITEL[anliegen] : 'Haus anfragen';
---
{anliegen ? (
  <section id="anfrage" class="anfrage fest">
    <div class="anfrage-bild">
      <Bild src={bild ?? katalogBild('144')} alt={bildAlt} sizes="(min-width: 1024px) 50vw, 0px" />
    </div>
    <div class="anfrage-inhalt">
      <h2 class="h2">{titel}</h2>
      <Anfrageformular anliegen={anliegen} />
    </div>
  </section>
) : (
  <section id="anfrage" class="anfrage auswahl">
    <div class="w">
      <div class="anfrage-inhalt">
        <h2 class="h2">{titel}</h2>
        <Anfrageformular />
      </div>
    </div>
  </section>
)}

<style>
  .anfrage { margin-top: 64px; padding: 48px 0; scroll-margin-top: 16px; }
  .anfrage-inhalt { display: flex; flex-direction: column; gap: 16px; }
  .fest .anfrage-inhalt { padding-inline: 20px; }
  .anfrage-bild { display: none; }
  @media (min-width: 1024px) {
    .anfrage { margin-top: 120px; }
    .auswahl { padding: 96px 0; }
    .auswahl .anfrage-inhalt { max-width: 680px; gap: 28px; }
    /* Bild läuft über die ganze Höhe des Abschnitts bis an den Footer, auch wenn das Formular höher wird (Kalender) */
    .fest { padding: 0; display: grid; grid-template-columns: 1fr 64px minmax(0, 576px) minmax(20px, calc((100vw - 1200px) / 2)); align-items: stretch; }
    .fest .anfrage-inhalt { grid-column: 3; padding: 0 0 80px; gap: 28px; }
    .anfrage-bild { display: block; position: relative; grid-column: 1; min-height: 760px; }
    .anfrage-bild :global(picture) { position: absolute; inset: 0; display: block; }
    .anfrage-bild :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 80% center; }
    .bild-offen { position: absolute; left: 16px; top: 16px; font-size: 14px; }
  }
</style>
