---
// Bild mit passenden Größen je Bildschirm.
// Astro erzeugt beim Build aus EINER Quelldatei mehrere Breiten (srcset).
// Der Browser wählt anhand von `sizes` und Bildschirmdichte die kleinste passende.
// Regel: Quellbilder in src/assets/bilder/ als WebP, längste Kante max. 2400 px.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  // Wie breit das Bild im Layout dargestellt wird. Standard: volle Breite.
  sizes?: string;
  priorisiert?: boolean; // true für das erste große Bild (Hero)
}
const { src, alt, sizes = '100vw', priorisiert = false } = Astro.props;
const breiten = [480, 800, 1200, 1600, 2400].filter((b) => b <= src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={breiten.length ? breiten : [src.width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={priorisiert ? 'eager' : 'lazy'}
  fetchpriority={priorisiert ? 'high' : 'auto'}
/>
