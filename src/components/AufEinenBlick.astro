---
// „Auf einen Blick“ der Zielgruppenseiten: Infokarten mit Icon links, Lage mit Skizze rechts (Desktop),
// mobil untereinander. Text darf <br> enthalten; [ … ] wird als offen markiert.
import { ICON, type IconName } from '../lib/icons';
import { ROUTE_LINK } from '../lib/kontakt';
import lageskizze from '../assets/bilder/lageskizze.svg?raw';
interface Karte { icon: IconName; titel: string; text: string; link?: { href: string; text: string } }
interface Props { karten: Karte[]; lage: string; einleitung?: string; titel?: string }
const { karten, lage, einleitung, titel = 'Auf einen Blick' } = Astro.props;
const markiere = (t: string) => t.replace(/\[([^\]]+)\]/g, '<span class="offen-markiert">[$1]</span>');
---
<section class="w sektion aeb">
  <h2 class="h2">{titel}</h2>
  {einleitung && <p class="p einleitung">{einleitung}</p>}
  <div class="aeb-raster">
    <div class="aeb-karten">
      {karten.map((k) => (
        <div class="aeb-karte">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[k.icon]} />
          <div class="aeb-text">
            <span class="aeb-titel">{k.titel}</span>
            <span set:html={markiere(k.text)} />
            {k.link && <a class="textlink" href={k.link.href} download><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON.download} />{k.link.text}</a>}
          </div>
        </div>
      ))}
    </div>
    <div class="aeb-karte aeb-lage">
      <div class="aeb-zeile">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON.ort} />
        <div class="aeb-text"><span class="aeb-titel">Lage</span><span set:html={markiere(lage)} /></div>
      </div>
      <div class="aeb-skizze" set:html={lageskizze} />
      <a class="textlink" href={ROUTE_LINK} target="_blank" rel="noopener">Route planen in Google Maps<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON.extern} /></a>
    </div>
  </div>
</section>

<style>
  .aeb > .h2 { margin-bottom: 12px; }
  .aeb-raster, .aeb-karten { display: flex; flex-direction: column; gap: 12px; }
  .aeb-karte { background: #fff; border-radius: var(--radius-lg); padding: 16px; display: flex; gap: 16px; align-items: flex-start; }
  .aeb-karte > svg, .aeb-zeile > svg { flex: 0 0 24px; width: 24px; height: 24px; margin-top: 2px; }
  .aeb-text { display: flex; flex-direction: column; gap: 2px; font-size: 15px; line-height: 1.5; }
  .aeb-titel { font-size: 16px; font-weight: 500; color: #000; }
  .aeb-lage { flex-direction: column; gap: 12px; }
  .aeb-zeile { display: flex; gap: 16px; align-items: flex-start; }
  .aeb-skizze :global(svg) { width: 100%; height: auto; display: block; border-radius: var(--radius-lg); }
  @media (min-width: 1024px) {
    .aeb > .h2 { margin-bottom: 0; }
    .aeb-raster { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
    .aeb-karten { gap: 24px; }
    .aeb-karte { padding: 24px; gap: 20px; }
    .aeb-karte > svg, .aeb-zeile > svg { flex-basis: 28px; width: 28px; height: 28px; }
    .aeb-text { gap: 4px; font-size: 16px; line-height: 1.55; }
    .aeb-titel { font-size: 18px; }
    .aeb-lage { gap: 16px; }
    /* Lage-Karte so hoch wie die Karten links zusammen: die Skizze nimmt nur den übrigen Platz */
    .aeb-skizze { flex: 1 1 0; min-height: 160px; display: flex; }
    .aeb-skizze :global(svg) { width: 100%; height: 100%; }
  }
</style>
