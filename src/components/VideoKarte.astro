---
// Video in einer gerundeten 16:9-Karte, startet erst auf Klick (Handoff 21.11.). Quelle: R2 (src/lib/videos.ts).
import { videoQuellen, type VideoName } from '../lib/videos';
interface Props { name: VideoName; label: string }
const { name, label } = Astro.props;
---
<div class="video-karte" data-videokarte>
  <video preload="metadata" playsinline aria-label={label}>
    {videoQuellen(name).map((q) => <source src={q.src} type={q.type} />)}
  </video>
  <button type="button" class="abspielen" aria-label={`${label} abspielen`}>
    <svg width="36" height="36" viewBox="0 0 24 24" fill="#000" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3" /></svg>
  </button>
</div>

<style>
  .video-karte { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius-xl); overflow: hidden; background: var(--neutral-300); }
  video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .abspielen { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 72px; height: 72px; border-radius: 9999px; border: 0; background: rgba(255, 255, 255, .92); box-shadow: 0 4px 16px rgba(0, 0, 0, .25); display: flex; align-items: center; justify-content: center; padding: 0 0 0 4px; cursor: pointer; }
  @media (min-width: 1024px) { .abspielen { width: 88px; height: 88px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-videokarte]').forEach((k) => {
    const b = k.querySelector('button')!;
    b.addEventListener('click', () => { const v = k.querySelector('video')!; v.controls = true; v.play(); b.remove(); });
  });
</script>
