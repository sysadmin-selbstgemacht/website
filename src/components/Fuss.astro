---
// Fußzeile mit dem gemeinsamen Anfrageformular (Brief 6d).
// Das Anliegen ist je Seite vorausgewählt.
import Anfrageformular from './Anfrageformular.astro';
import type { Anliegen } from '../lib/anfrage';
interface Props {
  anliegen?: Anliegen;
}
const { anliegen } = Astro.props;
---
<footer class="fuss">
  <section id="anfrage" class="anfrage">
    <h2>Anfrage</h2>
    <p class="offen">Offen: Ansprache du/Sie, Empfängeradresse. Versand läuft im Trockenlauf (zeigt die Mail an, verschickt nichts).</p>
    <Anfrageformular anliegen={anliegen} />
  </section>
  <section class="kontakt">
    <p>SELBSTGEMACHT – Seminar- und Gästehaus · Arnsgrün</p>
    <p class="offen">Offen: Telefon, Mail, Anfahrt, Social-Media-Links (Katrins Profile oder Haus-Profile?)</p>
    <ul class="rechtliches">
      <li><a href="/impressum/">Impressum</a></li>
      <li><a href="/datenschutz/">Datenschutz</a></li>
    </ul>
  </section>
</footer>
